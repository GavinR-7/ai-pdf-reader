# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the committed template of which variables exist. Values are never
# committed; the file documents the names only.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test fixtures (PDFs are large and not ours to redistribute)
test-pdfs/

# pdf.js runtime assets, copied from node_modules by scripts/copy-pdf-assets.mjs
public/pdfjs/
