# Copy to .env.local and fill in. .env.local is git-ignored; this file is not.
# Nothing here is required until Phase 4 — Phases 0-3 run entirely in the
# browser with no server-side keys.

# Anthropic API key, used only by the server route app/api/analyze/route.ts.
# Never referenced from client code: a NEXT_PUBLIC_ prefix would ship it to
# the browser, so this name intentionally lacks one.
ANTHROPIC_API_KEY=
