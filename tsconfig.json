{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    /* Beyond `strict`: reading past the end of an array yields `T | undefined`
       instead of `T`. The player indexes a chunk queue constantly
       (chunks[i + 1] for lookahead), and this is the compiler catching the
       off-by-one at the end of the document. Cost: real index reads need a
       guard. See ARCHITECTURE.md. */
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    /* scripts/verify-extract.mts runs under Node's native type stripping, which
       requires import specifiers to carry the real ".ts" extension. Safe here
       because noEmit is set, so TypeScript never has to rewrite a path. */
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
